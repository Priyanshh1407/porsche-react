# Copy to .env.local for local overrides. Values are baked into the build (they are public).

# Backend base URL for a deployed build, e.g. https://api.example.com
# Leave unset in development: requests use /api/... and the CRA dev server proxies them to
# http://localhost:5000 (see "proxy" in package.json).
REACT_APP_API_URL=
