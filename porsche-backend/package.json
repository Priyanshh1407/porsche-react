{
  "name": "porsche-backend",
  "version": "1.0.0",
  "description": "Porsche website contact system backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:db:up": "docker compose -f ../docker-compose.yml up -d --wait test-db",
    "test:db:down": "docker compose -f ../docker-compose.yml down"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/test-env.cjs"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.cjs",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/require-assertions.cjs"
    ]
  },
  "keywords": [
    "porsche",
    "contact-form",
    "backend",
    "nodejs",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "Priyansh Waghela",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}
