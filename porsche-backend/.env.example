# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/porsche

# Admin login + JWT signing
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# SMTP for contact-form emails. Leave EMAIL_PASS empty to log emails to the console instead.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com

# Tests only (optional). Defaults to the docker-compose test-db:
# DATABASE_URL_TEST=postgresql://porsche_test:porsche_test@localhost:5433/porsche_test
