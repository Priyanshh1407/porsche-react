# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Number of reverse-proxy hops in front of the app (e.g. 1 on Render/Railway). Leave 0 locally.
TRUST_PROXY=0

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/porsche

# Admin login + JWT signing
JWT_SECRET=replace-with-a-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# SMTP for contact-form emails. Leave EMAIL_PASS empty to log emails to the console instead.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
# Optional: max wait per SMTP step in ms (default 10000). The outbox worker sends and retries emails.
# EMAIL_TIMEOUT_MS=10000

# AI features (optional): lead triage in the admin + the concierge chat, on Google Gemini.
# Leave empty and both stay off (new leads are still queued for triage). Add a key from
# https://aistudio.google.com/apikey and restart the backend: everything switches on.
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Optional: route Gemini calls through a proxy (the E2E tests point it at a local fake).
# GEMINI_BASE_URL=

# Tests only (optional). Defaults to the docker-compose test-db:
# DATABASE_URL_TEST=postgresql://porsche_test:porsche_test@localhost:5433/porsche_test
